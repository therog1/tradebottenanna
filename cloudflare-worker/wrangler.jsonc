{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradebottenanna",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "okx_eu_demo",
    "TRADING_ENABLED": "false"
  },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS"
  }
}
