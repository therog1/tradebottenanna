# ==============================================================================
# TradebottenAnna — Environment Configuration Template
# KEEP REPOSITORY PRIVATE. NEVER COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# 1. Gemini AI Adviser Credentials
# Required for server-side /api/gemini-advice endpoint.
# In Cloudflare Worker: configure via `npx wrangler secret put GEMINI_API_KEY`
# In Local Dev: copy this file to .env and insert your Gemini API Key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. OKX EU Demo Trading Credentials
# Strictly for OKX Demo / Simulated Trading environment.
# Never use live production API keys.
OKX_DEMO_API_KEY="YOUR_OKX_DEMO_API_KEY"
OKX_DEMO_SECRET_KEY="YOUR_OKX_DEMO_SECRET_KEY"
OKX_DEMO_PASSPHRASE="YOUR_OKX_DEMO_PASSPHRASE"

# 3. Demo Trading Safety Guardrails
# Must be set to true only when ready to test simulated orders. Defaults to false.
DEMO_TRADING_ENABLED="false"
ENVIRONMENT="okx_eu_demo"

# 4. Cloudflare Access Identity
# Authorized email identity enforced via Cloudflare Access Zero Trust
CF_ACCESS_ALLOWED_EMAIL="rogedv@icloud.com"

# 5. Service Port (Local Dev & Server)
PORT=3000
