# GEMINI_API_KEY: Gratis API-nyckel från Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="din_gemini_api_nyckel"

# Börsens API-nycklar (t.ex. Bybit Perpetual Futures)
EXCHANGE_ID="bybit"
BYBIT_API_KEY="din_bybit_api_nyckel"
BYBIT_API_SECRET="din_bybit_api_secret"

# Test- och säkerhetslägen
DRY_RUN="false"
USE_TESTNET="false"

# Riskhantering & Strategi
RISK_PER_TRADE_PCT="1.5"
MIN_CONFIDENCE="0.72"
MAX_LEVERAGE="10"
MIN_LEVERAGE="3"
TIMEFRAME="15m"

# Valfria Telegram-notiser vid order
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# APP_URL för webbapplikationen
APP_URL="MY_APP_URL"
